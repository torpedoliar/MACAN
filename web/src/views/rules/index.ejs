<%- include('/partials/head', { title: 'Aturan MAC' }) %>

<% const fmt = d => d ? new Date(d).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '—'; %>

<% if (error) { %>
<div class="alert alert--danger" role="alert">
  <svg class="icon" aria-hidden="true"><use href="#i-x-circle"></use></svg>
  <div><strong>Gagal.</strong> <%= error %></div>
</div>
<% } %>
<% if (imported) { %>
<div class="alert alert--success" role="status" data-autodismiss>
  <svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>
  <div><strong><%= imported %> baris tersimpan.</strong><%= skipped ? (' ' + skipped + ' baris dilewati.') : '' %></div>
</div>
<% } %>

<section class="card">
  <div class="card__head">
    <h2>Aturan MAC</h2>
    <div class="btn-row">
      <a class="btn btn--primary btn--sm" href="/rules/new">
        <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>
        Tambah aturan
      </a>
      <a class="btn btn--sm" href="/rules/export.csv">
        <svg class="icon" aria-hidden="true"><use href="#i-download"></use></svg>
        Ekspor CSV
      </a>
      <a class="btn btn--sm" href="/rules/template.csv">
        <svg class="icon" aria-hidden="true"><use href="#i-download"></use></svg>
        Contoh isian
      </a>
    </div>
  </div>
  <div class="card__body">
    <p class="card__hint">Daftar perangkat yang boleh atau ditolak terhubung, dikelompokkan per jaringan (SSID).</p>
    <form action="/rules" method="GET" class="filters" style="margin-top:var(--s3)">
      <div class="field">
        <label class="field__label" for="q">Cari</label>
        <input type="search" id="q" name="q" value="<%= filters.q %>" placeholder="MAC, nama jaringan, pemilik, perangkat">
      </div>
      <div class="field">
        <label class="field__label" for="f-status">Status</label>
        <select id="f-status" name="status">
          <option value="">Semua</option>
          <option value="allow" <%= filters.status === 'allow' ? 'selected' : '' %>>Izinkan</option>
          <option value="deny" <%= filters.status === 'deny' ? 'selected' : '' %>>Tolak</option>
          <option value="disabled" <%= filters.status === 'disabled' ? 'selected' : '' %>>Nonaktif</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Tidak aktif lama</option>
        </select>
      </div>
      <div class="field">
        <label class="field__label" for="f-ctrl">Pilih CloudKey</label>
        <select id="f-ctrl" name="controller_id">
          <option value="">Semua</option>
          <option value="global" <%= filters.controller_id === 'global' ? 'selected' : '' %>>Semua jaringan</option>
          <% controllers.forEach(c => { %>
          <option value="<%= c.id %>" <%= String(filters.controller_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="field">
        <label class="field__label" for="f-ssid">Jaringan (SSID)</label>
        <select id="f-ssid" name="ssid">
          <option value="">Semua</option>
          <% (typeof ssidOptions !== 'undefined' ? ssidOptions : []).forEach(s => { %>
          <% const opt = s && typeof s === 'object' ? s : { ssid_name: s }; %>
          <option value="<%= opt.ssid_name %>" <%= String((filters && filters.ssid) || '') === String(opt.ssid_name) ? 'selected' : '' %>><%= opt.ssid_name %><%= showControllerPrefix && opt.controller_id ? (' — ' + ctrlNames.get(opt.controller_id)) : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="filters__actions">
        <button class="btn btn--primary" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-search"></use></svg>
          Filter
        </button>
        <a class="btn" href="/rules">Bersihkan</a>
      </div>
    </form>
  </div>
  <% if (!rules.length) { %>
    <div class="card__body empty">
      <svg class="icon" aria-hidden="true"><use href="#i-empty"></use></svg>
      <h3>Belum ada aturan</h3>
      <p>Tambah aturan manual, import dari CSV, atau setujui perangkat dari halaman Approval.</p>
      <div class="btn-row" style="justify-content:center">
        <a class="btn btn--primary" href="/rules/new">Tambah aturan</a>
        <a class="btn" href="/approvals">Ke Approval</a>
      </div>
    </div>
  <% } else { %>
  <div class="card__body" style="padding-bottom:0">
    <p class="card__hint">Dikelompokkan per CloudKey, lalu per jaringan (SSID). <%= rules.length %> aturan — maksimal 500 per halaman.
      <% if (filters.q || filters.status || filters.controller_id || filters.ssid) { %>Filter aktif — persempit atau bersihkan untuk melihat semua.<% } %></p>
  </div>
  <% const SEP = String.fromCharCode(0); %>
  <% const groups = flat ? [{ ctrl: 0, ssidLabel: filters.ssid || 'Semua jaringan', group: rules }] : Object.keys(ctrlGroups).sort((a, b) => { const ca = Number(a.split(SEP)[0]); const cb = Number(b.split(SEP)[0]); return (ca === 0 && cb !== 0 ? -1 : ca !== 0 && cb === 0 ? 1 : ca - cb); }).map(key => ({ ctrl: Number(key.split(SEP)[0]), ssidLabel: key.split(SEP)[1], group: ctrlGroups[key] })); %>
  <% groups.forEach(g => { const allow = g.group.filter(r => r.status === 'allow'); const others = g.group.filter(r => r.status !== 'allow'); const icon = flat ? 'wifi' : 'router'; %>
  <section class="rule-group">
    <h3 class="rule-group__head">
      <svg class="icon" aria-hidden="true"><use href="#i-<%= icon %>"></use></svg>
      <%= g.ctrl === 0 && flat ? g.ssidLabel : ctrlNames.get(g.ctrl) %>
      <span class="badge"><%= g.group.length %> aturan</span>
    </h3>
    <% if (!flat) { %>
    <h4 class="rule-group__subhead rule-group__subhead--allow">
      <span><%= g.ssidLabel %> <span class="card__hint">(<%= ctrlNames.get(g.ctrl) %>)</span></span>
    </h4>
    <% } %>
    <% if (allow.length) { %>
    <h4 class="rule-group__subhead rule-group__subhead--allow">
      <span>Izinkan</span><span class="badge"><%= allow.length %></span>
    </h4>
    <div class="table-wrap">
      <table class="data stackable">
        <thead>
          <tr>
            <th>Perangkat (MAC)</th><th>Nama</th><th>Jangkauan</th><th>Status</th>
            <th>Pemilik</th><th>Perangkat</th><th>Terakhir online</th><th class="actions">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% allow.forEach(r => { %><% const rv = vendorOf(r.mac_address); %>
          <tr>
            <td data-label="Perangkat" class="mono">
              <%= r.mac_address %>
              <% if (rv) { %><br><span class="card__hint"><%= rv %></span><% } %>
            </td>
            <td data-label="Nama"><%= r.hostname || '—' %></td>
            <td data-label="Jangkauan">
              <% if (r.controller_id) { %><%= r.controller_name || ('#' + r.controller_id) %><% } else { %>
              <span class="badge badge--accent">Semua jaringan</span><% } %>
              <% if (r.ssid_group_id) { %>
              <span class="badge badge--info" title="Dipasang lewat grup SSID <%= r.group_name || ('#' + r.ssid_group_id) %>">via grup <%= r.group_name || ('#' + r.ssid_group_id) %></span>
              <% } %>
            </td>
            <td data-label="Status">
              <span class="badge badge--<%= r.status %>"><%= r.status === 'allow' ? 'Izinkan' : r.status === 'deny' ? 'Tolak' : 'Nonaktif' %></span>
              <% if (r.inactive_since && r.status !== 'allow') { %>
              <span class="badge badge--disabled" title="Tidak pernah terhubung sampai batas hari; diubah otomatis <%= fmt(r.inactive_since) %>">Tidak aktif lama</span>
              <% } %>
            </td>
            <td data-label="Pemilik"><%= r.owner_name || '—' %></td>
            <td data-label="Perangkat"><%= r.device_name || '—' %></td>
            <td data-label="Terakhir online" class="num"><%= fmt(r.last_seen_at) %></td>
            <td data-label="Aksi" class="actions">
              <a class="btn btn--sm" href="/rules/<%= r.id %>/edit">
                <svg class="icon" aria-hidden="true"><use href="#i-edit"></use></svg>
                Edit
              </a>
              <form action="/rules/<%= r.id %>/delete" method="POST"
                    data-confirm="Hapus aturan <%= r.mac_address %> di SSID <%= r.ssid_name %>?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--sm btn--danger" type="submit">
                  <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>
                  Hapus
                </button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
    <% if (others.length) { %>
    <details class="rule-group__details">
      <summary class="rule-group__subhead">
        <span>Tolak / Nonaktif</span><span class="badge"><%= others.length %></span>
      </summary>
      <div class="table-wrap">
        <table class="data stackable">
          <thead>
            <tr>
              <th>Perangkat (MAC)</th><th>Nama</th><th>Jangkauan</th><th>Status</th>
              <th>Pemilik</th><th>Perangkat</th><th>Terakhir online</th><th class="actions">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% others.forEach(r => { %><% const rv = vendorOf(r.mac_address); %>
            <tr>
              <td data-label="Perangkat" class="mono">
                <%= r.mac_address %>
                <% if (rv) { %><br><span class="card__hint"><%= rv %></span><% } %>
              </td>
              <td data-label="Nama"><%= r.hostname || '—' %></td>
              <td data-label="Jangkauan">
                <% if (r.controller_id) { %><%= r.controller_name || ('#' + r.controller_id) %><% } else { %>
                <span class="badge badge--accent">Semua jaringan</span><% } %>
                <% if (r.ssid_group_id) { %>
                <span class="badge badge--info" title="Dipasang lewat grup SSID <%= r.group_name || ('#' + r.ssid_group_id) %>">via grup <%= r.group_name || ('#' + r.ssid_group_id) %></span>
                <% } %>
              </td>
              <td data-label="Status">
                <span class="badge badge--<%= r.status %>"><%= r.status === 'allow' ? 'Izinkan' : r.status === 'deny' ? 'Tolak' : 'Nonaktif' %></span>
                <% if (r.inactive_since && r.status !== 'allow') { %>
                <span class="badge badge--disabled" title="Tidak pernah terhubung sampai batas hari; diubah otomatis <%= fmt(r.inactive_since) %>">Tidak aktif lama</span>
                <% } %>
              </td>
              <td data-label="Pemilik"><%= r.owner_name || '—' %></td>
              <td data-label="Perangkat"><%= r.device_name || '—' %></td>
              <td data-label="Terakhir online" class="num"><%= fmt(r.last_seen_at) %></td>
              <td data-label="Aksi" class="actions">
                <a class="btn btn--sm" href="/rules/<%= r.id %>/edit">
                  <svg class="icon" aria-hidden="true"><use href="#i-edit"></use></svg>
                  Edit
                </a>
                <form action="/rules/<%= r.id %>/delete" method="POST"
                      data-confirm="Hapus aturan <%= r.mac_address %> di SSID <%= r.ssid_name %>?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn--sm btn--danger" type="submit">
                    <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>
                    Hapus
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </details>
    <% } %>
  </section>
  <% }); %>
  <% } %>
</section>
<section class="card">
  <div class="card__head"><h2>Import aturan dari CSV</h2></div>
  <div class="card__body">
    <form action="/rules/import" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label class="field__label" for="csv">File CSV<span class="field__req" aria-hidden="true">*</span></label>
        <input type="file" id="csv" name="csv" accept=".csv,text/csv" required
               aria-describedby="csv-hint">
        <span class="field__hint" id="csv-hint">
          Kolom: <code class="mono">scope,controller,ssid,mac,status,owner,device,note</code>.
          <code class="mono">scope</code> = <code class="mono">global</code> atau <code class="mono">controller</code>
          (kalau <code class="mono">controller</code>, kolom <code class="mono">controller</code> harus berisi nama controller yang sudah terdaftar).
          MAC boleh dengan atau tanpa pemisah. Baris header opsional. Maksimal 2 MB.
          Rule yang sudah ada akan diperbarui, bukan diduplikasi.
          Untuk memasang satu MAC ke seluruh SSID dalam satu grup, isi kolom
          <code class="mono">ssid</code> dengan <code class="mono">group:Nama Grup</code>.
        </span>
      </div>
      <button class="btn btn--primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-upload"></use></svg>
        Import
      </button>
    </form>
  </div>
</section>

<%- include('/partials/foot') %>