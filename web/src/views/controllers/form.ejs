<%- include('/partials/head', { title: controller.id ? 'Edit Controller' : 'Tambah Controller' }) %>

<section class="card" style="max-width:720px">
  <div class="card__head">
    <h2><%= controller.id ? 'Edit controller' : 'Controller baru' %></h2>
    <div class="btn-row"><a class="btn btn--sm" href="/controllers">Kembali</a></div>
  </div>
  <div class="card__body">
    <% if (error) { %>
    <div class="alert alert--danger" role="alert">
      <svg class="icon" aria-hidden="true"><use href="#i-x-circle"></use></svg>
      <div><%= error %></div>
    </div>
    <% } %>

    <form action="/controllers/<%= controller.id || '' %>" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="grid-2">
        <div class="field">
          <label class="field__label" for="name">Nama<span class="field__req" aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required value="<%= controller.name || '' %>"
                 maxlength="120" placeholder="UniFi Pusat">
        </div>
        <div class="field">
          <label class="field__label" for="ip_address">IP address / subnet<span class="field__req" aria-hidden="true">*</span></label>
          <input type="text" id="ip_address" name="ip_address" required
                 value="<%= controller.ip_address || '' %>" placeholder="10.10.0.0/24"
                 maxlength="45" spellcheck="false" aria-describedby="ip-hint">
          <span class="field__hint" id="ip-hint">IP sumber request RADIUS. Satu host (<code class="mono">10.10.0.100</code>) atau satu subnet (<code class="mono">10.10.0.0/24</code>) bila AP mengirim langsung ke RADIUS. Prefix <code class="mono">/8</code>–<code class="mono">/32</code>; shared secret berlaku untuk seluruh subnet itu.</span>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="shared_secret">
          Shared secret RADIUS<% if (!controller.id) { %><span class="field__req" aria-hidden="true">*</span><% } %>
        </label>
        <input type="password" id="shared_secret" name="shared_secret"
               <%= controller.id ? '' : 'required' %> autocomplete="new-password"
               minlength="8" maxlength="255" aria-describedby="secret-hint"
               placeholder="<%= controller.id ? 'Kosongkan bila tidak diganti' : 'Minimal 8 karakter' %>">
        <span class="field__hint" id="secret-hint">
          Minimal 8 karakter, harus sama dengan yang diisi di UniFi.
          <% if (controller.id) { %>Kosongkan untuk mempertahankan secret yang sekarang — nilainya tidak pernah ditampilkan ulang.<% } %>
        </span>
      </div>

      <div class="field">
        <label class="check" for="enabled">
          <input type="checkbox" id="enabled" name="enabled" value="1"
                 <%= controller.enabled === undefined || controller.enabled ? 'checked' : '' %>>
          <span>Aktif — terima request RADIUS dari controller ini</span>
        </label>
      </div>

      <div class="field">
        <label class="field__label" for="note">Catatan</label>
        <input type="text" id="note" name="note" value="<%= controller.note || '' %>">
      </div>

      <fieldset>
        <legend>UniFi Controller API (opsional)</legend>
        <p class="card__hint" style="margin-top:0;margin-bottom:var(--s4)">
          Untuk mengambil hostname device. Buat API key di UniFi Network →
          Settings → Control Plane → Integrations. Host ini controller UniFi,
          bukan IP sumber RADIUS di atas.
        </p>
        <div class="grid-2">
          <div class="field">
            <label class="field__label" for="unifi_host">Host UniFi</label>
            <input type="text" id="unifi_host" name="unifi_host"
                   value="<%= controller.unifi_host || '' %>" placeholder="https://10.10.0.100:443"
                   maxlength="255" spellcheck="false" inputmode="url">
          </div>
          <div class="field">
            <label class="field__label" for="unifi_site">Site</label>
            <input type="text" id="unifi_site" name="unifi_site"
                   value="<%= controller.unifi_site || 'default' %>" placeholder="default"
                   maxlength="64" spellcheck="false">
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="unifi_api_key">API key (integration v1)</label>
          <input type="password" id="unifi_api_key" name="unifi_api_key" autocomplete="new-password"
                 maxlength="255" aria-describedby="unifi-key-hint"
                 placeholder="<%= controller.id && controller.unifi_api_key ? 'Tersimpan — kosongkan bila tidak diganti' : 'X-API-KEY dari Integrations' %>">
          <span class="field__hint" id="unifi-key-hint">
            <% if (controller.id && controller.unifi_api_key) { %>Kosongkan untuk mempertahankan key yang sekarang.<% } else { %>Header <code class="mono">X-API-KEY</code> — ambil client <strong>online</strong> saja.<% } %>
          </span>
        </div>
        <div class="grid-2">
          <div class="field">
            <label class="field__label" for="unifi_username">Username UniFi (classic)</label>
            <input type="text" id="unifi_username" name="unifi_username"
                   value="<%= controller.unifi_username || '' %>" maxlength="160"
                   placeholder="akun read-only" autocomplete="username" spellcheck="false">
          </div>
          <div class="field">
            <label class="field__label" for="unifi_password">Password UniFi (classic)</label>
            <input type="password" id="unifi_password" name="unifi_password" autocomplete="new-password"
                   maxlength="255" aria-describedby="unifi-pass-hint"
                   placeholder="<%= controller.id && controller.unifi_password ? 'Tersimpan — kosongkan bila tidak diganti' : 'password akun UniFi' %>">
            <span class="field__hint" id="unifi-pass-hint">
              Login user/password untuk ambil <strong>semua device configured</strong> (offline included) lewat classic API. Pakai akun read-only kalau ada; kosongkan kalau cuma pakai API key.
            </span>
          </div>
        </div>
        <label class="check" for="unifi_verify_tls">
          <input type="checkbox" id="unifi_verify_tls" name="unifi_verify_tls" value="1"
                 <%= controller.unifi_verify_tls ? 'checked' : '' %>>
          <span>Verifikasi TLS — centang hanya kalau controller pakai sertifikat valid (bukan self-signed default UniFi)</span>
        </label>
      </fieldset>

      <div class="alert" role="note">
        <svg class="icon" aria-hidden="true"><use href="#i-info"></use></svg>
        <div>Tidak perlu restart. Controller baru langsung dikenali pada paket pertama;
          perubahan IP atau shared secret berlaku paling lama 5 menit.</div>
      </div>

      <div class="btn-row">
        <button class="btn btn--primary" type="submit">
          <svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>
          Simpan
        </button>
        <a class="btn" href="/controllers">Batal</a>
      </div>
    </form>
  </div>
</section>

<%- include('/partials/foot') %>
