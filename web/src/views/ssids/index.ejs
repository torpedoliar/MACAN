<%- include('/partials/head', { title: 'SSID' }) %>

<% const fmt = d => d ? new Date(d).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '—'; %>

<% if (error) { %>
<div class="alert alert--danger" role="alert">
  <svg class="icon" aria-hidden="true"><use href="#i-x-circle"></use></svg>
  <div><%= error %></div>
</div>
<% } %>
<% if (notice) { %>
<div class="alert alert--success" role="status" data-autodismiss>
  <svg class="icon" aria-hidden="true"><use href="#i-check"></use></svg>
  <div><%= notice %></div>
</div>
<% } %>

<section class="card">
  <div class="card__head"><h2>Inventaris SSID</h2></div>
  <% if (!ssids.length) { %>
    <div class="card__body empty">
      <svg class="icon" aria-hidden="true"><use href="#i-wifi"></use></svg>
      <h3>Belum ada SSID</h3>
      <p>SSID tercatat otomatis saat controller mengirim request MAC auth pertamanya,
        atau tambahkan manual di bawah.</p>
    </div>
  <% } else { %>
  <div class="table-wrap">
    <table class="data stackable">
      <thead>
        <tr><th>SSID</th><th>Controller</th><th>Status</th><th>Sumber</th><th class="num">Rule</th><th>Terakhir terlihat</th><th class="actions">Aksi</th></tr>
      </thead>
      <tbody>
        <% ssids.forEach(s => { %>
        <tr>
          <td data-label="SSID"><strong><%= s.ssid_name %></strong></td>
          <td data-label="Controller"><%= s.controller_name %></td>
          <td data-label="Status">
            <span class="badge badge--<%= s.enabled ? 'on' : 'off' %>">
              <span class="dot" aria-hidden="true"></span><%= s.enabled ? 'aktif' : 'nonaktif' %>
            </span>
          </td>
          <td data-label="Sumber">
            <span class="badge <%= s.auto_created ? 'badge--info' : '' %>"><%= s.auto_created ? 'otomatis' : 'manual' %></span>
          </td>
          <td data-label="Rule" class="num"><%= s.rule_count %></td>
          <td data-label="Terakhir terlihat" class="num"><%= fmt(s.last_seen_at) %></td>
          <td data-label="Aksi" class="actions">
            <form action="/ssids/<%= s.id %>/toggle" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="enabled" value="<%= s.enabled ? '0' : '1' %>">
              <button class="btn btn--sm" type="submit">
                <svg class="icon" aria-hidden="true"><use href="#<%= s.enabled ? 'i-x-circle' : 'i-check' %>"></use></svg>
                <%= s.enabled ? 'Nonaktifkan' : 'Aktifkan' %>
              </button>
            </form>
            <form action="/ssids/<%= s.id %>/delete" method="POST"
                  data-confirm="Hapus SSID <%= s.ssid_name %> dari inventaris?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--sm btn--danger" type="submit">
                <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>
                Hapus
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card__body">
    <p class="card__hint">SSID nonaktif menolak semua autentikasi di SSID itu, apa pun status rule MAC-nya.</p>
  </div>
  <% } %>
</section>

<section class="card">
  <div class="card__head"><h2>Tambah SSID manual</h2></div>
  <div class="card__body">
    <% if (!controllers.length) { %>
      <p class="card__hint">Daftarkan controller dulu di <a href="/controllers">halaman Controller</a>.</p>
    <% } else { %>
    <form action="/ssids" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid-2">
        <div class="field">
          <label class="field__label" for="controller_id">Controller<span class="field__req" aria-hidden="true">*</span></label>
          <select id="controller_id" name="controller_id" required>
            <option value="">Pilih controller</option>
            <% controllers.forEach(c => { %>
            <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label class="field__label" for="ssid_name">Nama SSID<span class="field__req" aria-hidden="true">*</span></label>
          <input type="text" id="ssid_name" name="ssid_name" required spellcheck="false"
                 maxlength="128" aria-describedby="ssid-hint">
          <span class="field__hint" id="ssid-hint">Harus sama persis dengan SSID di UniFi, termasuk huruf besar-kecil.</span>
        </div>
      </div>
      <button class="btn btn--primary" type="submit">
        <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>
        Tambah
      </button>
    </form>
    <% } %>
  </div>
</section>

<%- include('/partials/foot') %>
