<%- include('/partials/head', { title: 'Admin' }) %>

<% const fmt = d => d ? new Date(d).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '—'; %>

<% if (error) { %>
<div class="alert alert--danger" role="alert">
  <svg class="icon" aria-hidden="true"><use href="#i-x-circle"></use></svg>
  <div><%= error %></div>
</div>
<% } %>
<% if (notice) { %>
<div class="alert alert--info" role="status">
  <svg class="icon" aria-hidden="true"><use href="#i-info"></use></svg>
  <div><%= notice %></div>
</div>
<% } %>

<section class="card">
  <div class="card__head">
    <h2>Akun admin</h2>
    <div class="btn-row">
      <a class="btn btn--primary btn--sm" href="/admins/new">
        <svg class="icon" aria-hidden="true"><use href="#i-plus"></use></svg>
        Tambah admin
      </a>
    </div>
  </div>

  <div class="table-wrap">
    <table class="data stackable">
      <thead>
        <tr><th>Email</th><th>Status</th><th>Login terakhir</th><th>Dibuat</th><th class="actions">Aksi</th></tr>
      </thead>
      <tbody>
        <% accounts.forEach(a => { %>
        <tr>
          <td data-label="Email">
            <strong><%= a.email %></strong>
            <% if (Number(a.id) === Number(admin.id)) { %>
            <span class="badge badge--accent">Anda</span>
            <% } %>
          </td>
          <td data-label="Status">
            <span class="badge badge--<%= a.enabled ? 'on' : 'off' %>">
              <span class="dot" aria-hidden="true"></span><%= a.enabled ? 'aktif' : 'nonaktif' %>
            </span>
          </td>
          <td data-label="Login terakhir" class="num"><%= fmt(a.last_login) %></td>
          <td data-label="Dibuat" class="num"><%= fmt(a.created_at) %></td>
          <td data-label="Aksi" class="actions">
            <a class="btn btn--sm" href="/admins/<%= a.id %>/edit">
              <svg class="icon" aria-hidden="true"><use href="#i-edit"></use></svg>
              Edit
            </a>
            <% if (Number(a.id) !== Number(admin.id)) { %>
            <form action="/admins/<%= a.id %>/delete" method="POST"
                  data-confirm="Hapus admin <%= a.email %>? Riwayat audit tetap utuh sebagai 'deleted admin'.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--sm btn--danger" type="submit">
                <svg class="icon" aria-hidden="true"><use href="#i-trash"></use></svg>
                Hapus
              </button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <div class="card__body">
    <div class="alert alert--info" role="note" style="margin:0">
      <svg class="icon" aria-hidden="true"><use href="#i-info"></use></svg>
      <div>Menghapus akun menghilangkan akses dan menjaga <a href="/audit">Audit</a> tetap utuh
        (admin_id jadi kosong, tertulis "deleted admin"). Untuk sekadar mencabut akses, buka Edit
        lalu hilangkan tanda <strong>Aktif</strong>.</div>
    </div>
  </div>
</section>

<%- include('/partials/foot') %>
